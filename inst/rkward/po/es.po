# ================= MENÚS Y PESTAÑAS =================
msgid "Time Series Preparation"
msgstr "Preparación de Series de Tiempo"

msgid "1. Define Series & Impute Data"
msgstr "1. Definir Serie e Imputar Datos"

msgid "2. Decomposition (Classical & STL)"
msgstr "2. Descomposición (Clásica y STL)"

msgid "3. Diagnostics (ACF/PACF, Ljung-Box, ADF)"
msgstr "3. Diagnósticos (FAC/FACP, Ljung-Box, ADF)"

